# Copia este fichero a .env y ajústalo. docker compose lo lee automáticamente.

# --- Red ---
# Puerto HTTP interno donde escucha bamba (tu proxy inverso reenvía https://tu-dominio -> http://IP-de-esta-maquina:8080)
BAMBA_PORT=8080
# 0.0.0.0 = todas las interfaces (proxy en otra máquina/host). 127.0.0.1 solo si el proxy corre en esta misma máquina.
BAMBA_BIND=0.0.0.0

# --- Seguridad ---
# Estás detrás de HTTPS: marca la cookie de sesión como segura
COOKIE_SECURE=true
# Clave para firmar sesiones (si la dejas vacía se genera y se guarda en el volumen). Genera una con: openssl rand -hex 32
SECRET_KEY=
# Deja true para crear tu cuenta; después ponlo en false para que nadie más se registre
ALLOW_REGISTRATION=true

# --- IA (opcional) ---
# Texto: modelo local (docker compose --profile ai up -d) o API OpenAI-compatible
OLLAMA_MODEL=qwen2.5:1.5b
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Imagen: Stable Diffusion WebUI (A1111) con --api; si está vacío se usa Pollinations (gratuito, externo)
AI_IMAGE_URL=

# --- Quitar fondo ---
REMBG_DEFAULT_MODEL=isnet-general-use
MAX_IMAGE_SIDE=3000
